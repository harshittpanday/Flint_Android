<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flint_home_background">

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/launch_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_launcher_round" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/noto_sans_bold"
                        android:letterSpacing="0.12"
                        android:text="@string/app_short_name"
                        android:textAllCaps="true"
                        android:textColor="@color/flint_home_text"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/home_brand_subtitle"
                        android:textAllCaps="true"
                        android:textColor="@color/flint_home_quiet"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/notif_icon"
                    android:drawablePadding="6dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.08"
                    android:text="@string/home_ready_to_play"
                    android:textAllCaps="true"
                    android:textColor="@color/flint_home_accent"
                    android:textSize="9sp"
                    app:drawableTint="@color/flint_home_accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/flint_home_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.14"
                    android:text="@string/home_ready_to_play"
                    android:textAllCaps="true"
                    android:textColor="@color/flint_home_accent"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="@string/home_game_title"
                    android:textColor="@color/flint_home_text"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_game_subtitle"
                    android:textColor="@color/flint_home_muted"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/flint_home_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.1"
                    android:text="@string/home_selected_profile"
                    android:textAllCaps="true"
                    android:textColor="@color/flint_home_muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/flint_home_profile_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="10dp">

                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableEnd="@drawable/spinner_arrow"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/flint_home_text"
                        app:drawableEndPadding="@dimen/_1sdp"
                        app:drawableEndSize="18dp"
                        app:drawableStartIntegerScaling="true"
                        app:drawableStartSize="42dp"
                        tools:text="Default - latest release" />

                    <ImageButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/flint_home_edit_button"
                        android:contentDescription="@string/home_edit_profile"
                        android:padding="15dp"
                        android:src="@drawable/ic_edit_profile"
                        app:tint="@color/flint_home_accent" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="@string/home_change_profile_hint"
                    android:textColor="@color/flint_home_quiet"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.12"
                android:text="@string/home_quick_access"
                android:textAllCaps="true"
                android:textColor="@color/flint_home_text"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="12dp"
                android:text="@string/home_tools_subtitle"
                android:textColor="@color/flint_home_quiet"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <fr.spse.extended_view.ExtendedButton
                    android:id="@+id/news_button"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/flint_home_action_button"
                    android:drawableStart="@drawable/ic_menu_news"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical|start"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/mcl_tab_wiki"
                    android:textAllCaps="false"
                    android:textColor="@color/flint_home_text"
                    android:textSize="11sp"
                    app:drawableStartSize="24dp"
                    app:drawableTint="@color/flint_home_accent" />

                <fr.spse.extended_view.ExtendedButton
                    android:id="@+id/discord_button"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/flint_home_action_button"
                    android:drawableStart="@drawable/ic_discord"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical|start"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/mcl_button_discord"
                    android:textAllCaps="false"
                    android:textColor="@color/flint_home_text"
                    android:textSize="11sp"
                    app:drawableStartSize="24dp"
                    app:drawableTint="@color/flint_home_accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <fr.spse.extended_view.ExtendedButton
                    android:id="@+id/custom_control_button"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/flint_home_action_button"
                    android:drawableStart="@drawable/ic_menu_custom_controls"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical|start"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/mcl_option_customcontrol"
                    android:textAllCaps="false"
                    android:textColor="@color/flint_home_text"
                    android:textSize="11sp"
                    app:drawableStartSize="24dp"
                    app:drawableTint="@color/flint_home_accent" />

                <fr.spse.extended_view.ExtendedButton
                    android:id="@+id/install_jar_button"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/flint_home_action_button"
                    android:drawableStart="@drawable/ic_menu_install_jar"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical|start"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/main_install_jar_file"
                    android:textAllCaps="false"
                    android:textColor="@color/flint_home_text"
                    android:textSize="11sp"
                    app:drawableStartSize="24dp"
                    app:drawableTint="@color/flint_home_accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <fr.spse.extended_view.ExtendedButton
                    android:id="@+id/share_logs_button"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/flint_home_action_button"
                    android:drawableStart="@android:drawable/ic_menu_share"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical|start"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/main_share_logs"
                    android:textAllCaps="false"
                    android:textColor="@color/flint_home_text"
                    android:textSize="11sp"
                    app:drawableStartSize="24dp"
                    app:drawableTint="@color/flint_home_accent" />

                <fr.spse.extended_view.ExtendedButton
                    android:id="@+id/open_files_button"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/flint_home_action_button"
                    android:drawableStart="@drawable/ic_folder"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:gravity="center_vertical|start"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/mcl_button_open_directory"
                    android:textAllCaps="false"
                    android:textColor="@color/flint_home_text"
                    android:textSize="11sp"
                    app:drawableStartSize="24dp"
                    app:drawableTint="@color/flint_home_accent" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/home_attribution"
                android:textColor="@color/flint_home_quiet"
                android:textSize="9sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/launch_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/flint_home_bottom_bar"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="11dp"
        android:paddingEnd="18dp"
        android:paddingBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/noto_sans_bold"
            android:letterSpacing="0.1"
            android:text="@string/home_ready_to_launch"
            android:textAllCaps="true"
            android:textColor="@color/flint_home_muted"
            android:textSize="9sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/flint_home_play_button"
            android:drawableStart="@drawable/flint_home_play_icon"
            android:drawablePadding="12dp"
            android:fontFamily="@font/noto_sans_bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/main_play"
            android:textAllCaps="true"
            android:textColor="@color/flint_home_play_text"
            android:textSize="18sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
