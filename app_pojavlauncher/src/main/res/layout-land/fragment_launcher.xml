<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/flint_home_background">

    <LinearLayout
        android:id="@+id/home_landscape_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/launch_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.08"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_launcher_round" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/noto_sans_bold"
                        android:letterSpacing="0.12"
                        android:text="@string/app_short_name"
                        android:textAllCaps="true"
                        android:textColor="@color/flint_home_text"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/home_brand_subtitle"
                        android:textAllCaps="true"
                        android:textColor="@color/flint_home_quiet"
                        android:textSize="8sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.08"
                    android:text="@string/home_ready_to_play"
                    android:textAllCaps="true"
                    android:textColor="@color/flint_home_accent"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:background="@drawable/flint_home_card"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.12"
                    android:text="@string/home_ready_to_play"
                    android:textAllCaps="true"
                    android:textColor="@color/flint_home_accent"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="@string/home_game_title"
                    android:textColor="@color/flint_home_text"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.1"
                    android:text="@string/home_selected_profile"
                    android:textAllCaps="true"
                    android:textColor="@color/flint_home_muted"
                    android:textSize="8sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/flint_home_profile_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="8dp">

                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableEnd="@drawable/spinner_arrow"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/flint_home_text"
                        app:drawableEndPadding="@dimen/_1sdp"
                        app:drawableEndSize="16dp"
                        app:drawableStartIntegerScaling="true"
                        app:drawableStartSize="36dp"
                        tools:text="Default - latest release" />

                    <ImageButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/flint_home_edit_button"
                        android:contentDescription="@string/home_edit_profile"
                        android:padding="13dp"
                        android:src="@drawable/ic_edit_profile"
                        app:tint="@color/flint_home_accent" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_change_profile_hint"
                    android:textColor="@color/flint_home_quiet"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="0.92"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.12"
                    android:text="@string/home_quick_access"
                    android:textAllCaps="true"
                    android:textColor="@color/flint_home_text"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="9dp"
                    android:text="@string/home_tools_subtitle"
                    android:textColor="@color/flint_home_quiet"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <fr.spse.extended_view.ExtendedButton
                        android:id="@+id/news_button"
                        style="@style/FlintHomeActionButton"
                        android:layout_marginEnd="5dp"
                        android:drawableStart="@drawable/ic_menu_news"
                        android:text="@string/mcl_tab_wiki" />

                    <fr.spse.extended_view.ExtendedButton
                        android:id="@+id/discord_button"
                        style="@style/FlintHomeActionButton"
                        android:layout_marginStart="5dp"
                        android:drawableStart="@drawable/ic_discord"
                        android:text="@string/mcl_button_discord" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <fr.spse.extended_view.ExtendedButton
                        android:id="@+id/custom_control_button"
                        style="@style/FlintHomeActionButton"
                        android:layout_marginEnd="5dp"
                        android:drawableStart="@drawable/ic_menu_custom_controls"
                        android:text="@string/mcl_option_customcontrol" />

                    <fr.spse.extended_view.ExtendedButton
                        android:id="@+id/install_jar_button"
                        style="@style/FlintHomeActionButton"
                        android:layout_marginStart="5dp"
                        android:drawableStart="@drawable/ic_menu_install_jar"
                        android:text="@string/main_install_jar_file" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <fr.spse.extended_view.ExtendedButton
                        android:id="@+id/share_logs_button"
                        style="@style/FlintHomeActionButton"
                        android:layout_marginEnd="5dp"
                        android:drawableStart="@android:drawable/ic_menu_share"
                        android:text="@string/main_share_logs" />

                    <fr.spse.extended_view.ExtendedButton
                        android:id="@+id/open_files_button"
                        style="@style/FlintHomeActionButton"
                        android:layout_marginStart="5dp"
                        android:drawableStart="@drawable/ic_folder"
                        android:text="@string/mcl_button_open_directory" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center"
                    android:text="@string/home_attribution"
                    android:textColor="@color/flint_home_quiet"
                    android:textSize="8sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/launch_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/flint_home_bottom_bar"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.1"
                android:text="@string/home_ready_to_launch"
                android:textAllCaps="true"
                android:textColor="@color/flint_home_muted"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/home_game_title"
                android:textColor="@color/flint_home_quiet"
                android:textSize="9sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/play_button"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:background="@drawable/flint_home_play_button"
            android:drawableStart="@drawable/flint_home_play_icon"
            android:drawablePadding="10dp"
            android:fontFamily="@font/noto_sans_bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/main_play"
            android:textAllCaps="true"
            android:textColor="@color/flint_home_play_text"
            android:textSize="17sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
